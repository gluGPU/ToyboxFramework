{
  "globIgnorePaths": [
    "**/default.project.json",
    "**/moonwave.toml",
    "**/rokit.toml",
    "**/selene.toml",
    "**/stylua.toml",
    "**/wally.toml",
    "**/testez.yaml",
    "**/*.txt"
  ],
  
  "name": "toybox_build",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Game": {
        "$path": "src/Game"
      },

      "Engine": {
        "$path": "src/Engine"
      },

      "Tests": {
        "$path": "tests/ReplicatedStorage"
      }
    },

    "ServerStorage": {
      "Tests": {
        "$path": "tests/ServerStorage"
      }
    },

    "Players": {
      "$properties": {
      }
    },

    "StarterPlayer": {
      "StarterCharacterScripts": {
        "$path": "src/Build/StarterCharacterScripts"
      },

      "StarterPlayerScripts": {
        "$path": "src/Build/StarterPlayerScripts"
      }
    }
  }
}