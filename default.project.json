{
  "name": "toybox_build",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Engine": {
        "$path": "src/Engine"
      },

      "Tests": {
        "$path": "tests/ReplicatedStorage"
      }
    },

    "ServerStorage": {
      "Tests": {
        "$path": "tests/ServerStorage"
      }
    },

    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },

    "StarterPlayer": {
      "$properties": {
        "AutoJumpEnabled": false,
        "LuaCharacterController": "NoCharacterController",
        "EnableMouseLockOption": false,
        "DevComputerMovementMode": "Scriptable",
        "DevTouchMovementMode": "Scriptable",
        "DevComputerCameraMovementMode": "Classic",
        "DevTouchCameraMovementMode": "Classic",
        "LoadCharacterAppearance": false
      },

      "StarterCharacterScripts": {
        "$path": "src/Build/StarterCharacterScripts"
      },

      "StarterPlayerScripts": {
        "$path": "src/Build/StarterPlayerScripts"
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },



      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [
            0.38823,
            0.37254,
            0.38823
          ],
          "Locked": true,
          "Position": [
            0,
            -10,
            0
          ],
          "Size": [
            512,
            20,
            512
          ]
        }
      }
    },

    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],

        "OutdoorAmbient": [
          0, 0, 0
        ],

        "Brightness": 3,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Unified",
        "LightingStyle": "Realistic",
        "PrioritizeLightingQuality": true
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}