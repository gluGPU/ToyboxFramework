{
  "globIgnorePaths": [
    "**/default.project.json",
    "**/*.project.json",
    "**/moonwave.toml",
    "**/rokit.toml",
    "**/selene.toml",
    "**/stylua.toml",
    "**/wally.toml",
    "**/testez.yaml",
    "**/*.txt"
  ],
  
  "name": "toybox_build",
  "emitLegacyScripts": false,

  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Engine": {
        "$path": "src/Engine",

        "Services": {
          "$className": "Folder",
          
          "Client": {"$path": "src/Engine/Services/Client"},
          "Shared": {"$path": "src/Engine/Services/Shared"}
        }
      },

      "Tests": {
        "$path": "tests/ReplicatedStorage"
      }
    },

    "ServerStorage": {
      "$ignoreUnknownInstances": true,
      "$className": "ServerStorage",

      "Engine": {
        "$className": "Folder",

        "Services": {
          "$className": "Folder",
          
          "Server": {
            "$path": "src/Engine/Services/Server"
          }
        }
      },
      
      "Tests": {
        "$path": "tests/ServerStorage"
      }
    }
  }
}