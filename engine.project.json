{
  "globIgnorePaths": [
    "**/default.project.json",
    "**/*.project.json",
    "**/moonwave.toml",
    "**/rokit.toml",
    "**/selene.toml",
    "**/stylua.toml",
    "**/wally.toml",
    "**/testez.yaml",
    "**/*.txt"
  ],
  
  "name": "toybox_build",
  "emitLegacyScripts": false,

  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Engine": {
        "$path": "src/Engine"
      },

      "Tests": {
        "$path": "tests/ReplicatedStorage"
      }
    },

    "ServerStorage": {
      "Tests": {
        "$path": "tests/ServerStorage"
      }
    }
  }
}